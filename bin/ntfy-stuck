#!/usr/bin/env python3
"""
ntfy-stuck — notice when a session is going nowhere.

Catches three ways work actually stalls:
  1. Repeating — the same command keeps getting re-issued, usually after
     failing.
  2. Failing — a run of consecutive tool failures on different commands.
  3. Drifting — still marked "running" but nothing has moved for a while.

Alerts at most once per session per cooldown, so a genuinely stuck session
tells you once rather than every few minutes.

Detection is read-only against OpenCode's SQLite store (safe while the app
is running) plus the live session API.

Usage:
  ntfy-stuck            check now, alert on change
  ntfy-stuck -n         print only
  ntfy-stuck -s         show current verdict per session
  ntfy-stuck --reset    clear stored state
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import ntfy_activity as activity
import ntfy_oc as oc

STATE_DIR = oc.STATE_DIR
STATE_FILE = os.path.join(STATE_DIR, "stuck.json")
NOTIFY = oc.NOTIFY

LOOKBACK_MS = 25 * 60 * 1000     # how much history to consider
REPEAT_ALERT = 4                  # same command this many times -> alert
REPEAT_ALERT_FAILED = 3           # ...or 3x if the repeats were failing
CONSEC_FAILURES = 4               # this many failures in a row -> alert
DRIFT_MINUTES = 12                # "running" but silent this long -> alert
COOLDOWN_S = 45 * 60              # don't re-alert the same session sooner
MAX_HISTORY = 60                  # messages to scan per session

os.makedirs(STATE_DIR, exist_ok=True)

# Sniffed only for tools that actually EXECUTE something, because that is the
# only case where output is a result rather than content. Two changes from
# the old word list:
#   * bare words are gone — "error", "failed", "not found", "403", "404",
#     "500" turn up in ordinary output (grepping for 404, reading a log, a
#     file called not_found), and each false hit fed BOTH the repeat and the
#     consecutive-failure verdicts.
#   * read/grep/glob are excluded outright: file contents and search results
#     are not execution results.
ERROR_PHRASES = (
    "traceback (most recent call last)",
    "command not found",
    "no such file or directory",
    "permission denied",
    "connection refused",
    "connection timed out",
    "connection reset",
    "segmentation fault",
    "unauthorized",
    "not authorized",
    "exit code 1",
    "exit status 1",
)
EXEC_TOOLS = {"shell", "bash", "execute", "webfetch", "websearch",
              "task", "agent"}

# Set when the message store could not be read. Such a run must not look
# healthy: every session would print "ok" simply because we could not look.
STORE_ERRORS: list[str] = []

# Repeating an EDIT is normal, productive work — six edits to one file means
# refinement, not a loop. Repeat detection only applies to tools where doing
# the identical thing again implies the previous attempt didn't work.
REPEATABLE = {
    "shell", "bash", "execute", "webfetch", "websearch", "grep", "glob",
    "read", "task", "agent",
}
REPEAT_PREFIXES = ("browser",)

# A session that produced something very recently is working, whatever it
# repeats. Only call it stuck when there is no fresh progress.
ACTIVE_GRACE_MS = 2 * 60 * 1000

# ntfy_oc owns both of these — a local `def x(): return oc.x()` only implies
# a second implementation exists.
running_sessions = oc.running_sessions

def normalise(inp) -> str:
    """
    Fingerprint a tool call loosely, so "curl ... /a1" and "curl ... /a2"
    look like the same attempt rather than two different ones.
    """
    if isinstance(inp, dict):
        for k in ("command", "url", "path", "query", "pattern", "text"):
            v = inp.get(k)
            if isinstance(v, str) and v.strip():
                inp = v
                break
        else:
            inp = json.dumps(inp, sort_keys=True)
    s = " ".join(str(inp).split())
    s = re.sub(r"\d+", "N", s)           # ids, counts, line numbers
    s = re.sub(r"['\"][^'\"]*['\"]", "'S'", s)
    s = re.sub(r"https?://\S+", "URL", s)
    return s[:200].lower()

def recent_tools(sid: str) -> list[dict]:
    """Tool calls for a session, oldest -> newest, within the lookback."""
    try:
        con = oc.db()
        try:
            rows = con.execute(
                "select time_updated, data from session_message "
                "where session_id=? and type='assistant' and time_updated > ? "
                "order by time_updated desc limit ?",
                (sid, int(time.time() * 1000) - LOOKBACK_MS, MAX_HISTORY),
            ).fetchall()
        finally:
            con.close()
    except Exception as exc:
        # Returning [] silently meant a broken store printed "ok" for every
        # session — the exact failure a watchdog exists to catch. finish()
        # turns these into a non-zero exit, which ntfy-health reports as
        # "last run failed".
        STORE_ERRORS.append(f"recent_tools: {exc}")
        return []

    out: list[dict] = []
    for _, data in reversed(rows):
        try:
            items = json.loads(data).get("content") or []
        except Exception:
            continue
        for it in items:
            if it.get("type") != "tool":
                continue
            st = it.get("state") or {}
            inp = st.get("input")
            if isinstance(inp, str):
                try:
                    inp = json.loads(inp)
                except Exception:
                    pass
            status = st.get("status", "completed")
            failed = status not in ("completed",)
            if not failed and it.get("name", "") in EXEC_TOOLS:
                text = json.dumps(st.get("output") or st.get("content") or "")
                if any(w in text.lower() for w in ERROR_PHRASES):
                    failed = True
            out.append({
                "name": it.get("name", "tool"),
                "fp": f"{it.get('name','')}::{normalise(inp)}",
                "status": status,
                "failed": failed,
            })
    return out

def verdict(sid: str) -> dict | None:
    """Return a reason if this session looks stuck, else None."""
    tools = recent_tools(sid)

    # Is the session still actively producing output? If yes it is working,
    # and repeating itself is not evidence of being stuck.
    try:
        con = oc.db()
        try:
            row = con.execute(
                "select max(time_updated) from session_message where session_id=?",
                (sid,)).fetchone()
        finally:
            con.close()
        last = (row or [None])[0]
    except Exception as exc:
        STORE_ERRORS.append(f"freshness: {exc}")
        last = None
    fresh = bool(last) and (time.time() * 1000 - last) < ACTIVE_GRACE_MS

    # 1) the same command, again and again (only when NOT actively working,
    #    and only for tools where a repeat implies the last one didn't work)
    counts: dict[str, list[dict]] = {}
    for t in tools if not fresh else []:
        if t["name"] in REPEATABLE or t["name"].startswith(REPEAT_PREFIXES):
            counts.setdefault(t["fp"], []).append(t)
    worst = None
    for fp, group in counts.items():
        if len(group) < 3:
            continue
        fails = sum(1 for g in group if g["failed"])
        if len(group) >= REPEAT_ALERT or (len(group) >= REPEAT_ALERT_FAILED and fails >= 2):
            if worst is None or len(group) > worst[1]:
                worst = (fp, len(group), group)
    if worst:
        fp, n, group = worst
        name = group[0]["name"]
        phrase = activity.describe_tool(name, {"input": {"command": fp}})
        return {
            "kind": "repeating",
            "detail": f"{phrase} — the same thing {n} times in 25 min",
        }

    # 2) a run of consecutive failures on different commands
    tail = tools[-CONSEC_FAILURES:]
    if len(tail) == CONSEC_FAILURES and all(t["failed"] for t in tail):
        phrase = activity.describe_tool(tail[-1]["name"])
        return {
            "kind": "failing",
            "detail": f"{CONSEC_FAILURES} commands in a row failed, latest was {phrase.lower()}",
        }

    # 3) still "running" but nothing has moved
    if last and not fresh:
        idle_min = (time.time() * 1000 - last) / 60000
        if idle_min >= DRIFT_MINUTES:
            return {
                "kind": "drifting",
                "detail": f"running but nothing has happened for {int(idle_min)} min",
            }
    return None

def load_state() -> dict:
    try:
        return json.load(open(STATE_FILE))
    except Exception:
        return {}

def save_state(s: dict) -> None:
    try:
        json.dump(s, open(STATE_FILE, "w"))
    except Exception:
        pass

def finish(code: int) -> int:
    """Exit non-zero when the store could not be read.

    ntfy-health watches is-failed on this unit, so an unreadable store turns
    into a watchdog alert instead of every session quietly printing "ok".
    """
    if STORE_ERRORS:
        for err in STORE_ERRORS[:5]:
            print(f"store unreadable: {err}", file=sys.stderr)
        return 1
    return code


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("-n", "--dry", action="store_true")
    ap.add_argument("-s", "--status", action="store_true")
    ap.add_argument("--reset", action="store_true")
    args = ap.parse_args()

    if args.reset:
        if os.path.exists(STATE_FILE):
            os.remove(STATE_FILE)
        print("stuck state reset")
        return 0

    running = running_sessions()
    if not running:
        print("no running sessions")
        if not args.status and not args.dry:
            save_state({})
        return finish(0)

    state = load_state()
    now = time.time()
    found = []
    for s in running:
        v = verdict(s["id"])
        found.append((s, v))

    print(f"checking {len(running)} running session(s)\n")
    for s, v in found:
        if v:
            print(f"  STUCK  {oc.shorten(s['title'])}: [{v['kind']}] {v['detail']}")
        else:
            print(f"  ok     {oc.shorten(s['title'])}")

    if args.status:
        return finish(0)

    # Two cooldowns, both measured from the LAST alert:
    #   same problem  -> COOLDOWN_S (45 min)
    #   different one -> 900 s, so a session that changes tack cannot nag
    alerts = []
    for s, v in found:
        key = s["id"]
        prev = state.get(key) or {}
        sig = f"{v['kind']}:{v['detail']}" if v else ""
        if v is None:
            continue
        if prev.get("sig") == sig and now - prev.get("at", 0) < COOLDOWN_S:
            continue          # already told them about this exact thing
        if now - prev.get("at", 0) < 900:
            continue          # don't nag more than once every 15 min
        alerts.append((s, v, sig))

    alerted = {s["id"] for s, _, _ in alerts}
    new_state = {}
    for s, v in found:
        key = s["id"]
        prev = state.get(key) or {}
        if v:
            new_state[key] = {
                "sig": f"{v['kind']}:{v['detail']}",
                # Refreshed when we actually ALERT. Keeping the original
                # timestamp (the old `prev.get("at", now)`) meant both guards
                # were measured from first detection: once 15 minutes had
                # passed, the 900 s guard never applied again, and a
                # signature that grows every tick ("…for 13 min", "…for 14
                # min") also dodged the 45-minute one — so a session drifting
                # past 15 minutes pushed a notification every 3 minutes, for
                # as long as it stayed stuck.
                "at": now if key in alerted else prev.get("at", now),
                "title": s["title"],
            }
        elif prev:
            new_state[key] = {"sig": "", "at": now, "title": s["title"]}

    # A dry run must leave no trace: recording "at" here would arm the
    # cooldown with nothing having been sent, so the next real run would
    # stay silent — inspecting the stack would consume the alert.
    if not args.dry:
        save_state(new_state)

    if not alerts:
        print("\nnothing new to report")
        return finish(0)

    for s, v, _ in alerts:
        body = f"🌀 {oc.shorten(s['title'])}\n  {v['detail']}"
        if args.dry:
            print(f"\nDRY would send:\n{body}")
        else:
            if os.path.exists(NOTIFY):
                subprocess.run([NOTIFY, "-p", "high", body,
                                "OpenCode · looks stuck", "hourglass"],
                               capture_output=True, timeout=120)
                print(f"\nalerted: {s['title']}")
            else:
                print(f"\n(ntfy-notify missing at {NOTIFY} — not alerted: "
                      f"{s['title']})", file=sys.stderr)
    return finish(0)

if __name__ == "__main__":
    sys.exit(main())
