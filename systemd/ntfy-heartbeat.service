[Unit]
Description=OpenCode session heartbeat to phone (ntfy)
After=network-online.target

[Service]
Type=oneshot
# Keep PATH explicit: systemd does not inherit your shell profile.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ntfy-heartbeat
# Never let a hung curl block the next tick indefinitely.
TimeoutStartSec=90
