[Unit]
Description=Watchdog health check for OpenCode and the ntfy stack

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ntfy-health
# Exit 3 means "I found problems", which is this watchdog doing its job. Only
# a crash (exit 1) may count as a unit failure — otherwise every real problem
# made ntfy-health fail its own "a oneshot that failed on its last run" check,
# so it reported itself as broken and delayed the recovery notice for the
# actual fault.
SuccessExitStatus=0 3
TimeoutStartSec=120

[Install]
WantedBy=default.target
