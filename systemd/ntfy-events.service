[Unit]
Description=OpenCode real-time event notifications (turn end / permission prompts)
After=network-online.target
# OpenCode must be up to expose the SSE endpoint; retry handled in-process too.
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ntfy-events
Restart=always
RestartSec=5
# The daemon reconnects with its own backoff; don't let systemd race it.
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
